## Disaster Response AI - FastAPI Backend
# Build: docker build -f Dockerfile.api -t disaster-api .
# Run:   docker run -p 8000:8000 --env-file .env disaster-api

FROM python:3.11-slim

# System deps for ChromaDB (needs sqlite3) and sentence-transformers
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (cached layer unless requirements.txt changes)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir fastapi uvicorn[standard] langsmith

# Copy source
COPY . .

# Create logs directory
RUN mkdir -p logs data

EXPOSE 8000

# Healthcheck: Docker will restart the container if /health/ stops returning 200
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
