# Copy this file to .env and fill in your values
# cp .env.example .env

#  Required 
# Get a free Groq API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

#  LangSmith Tracing (Optional but strongly recommended) 
# Automatically traces every tool call, reasoning step, and retry in LangSmith.
# Get a free API key at: https://smith.langchain.com
# View your traces at:   https://smith.langchain.com/projects/disaster-response-ai
LANGCHAIN_API_KEY=ls__your_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=disaster-response-ai

#  FastAPI / Docker (set automatically by docker-compose.yml) 
# Only set this manually when running Streamlit outside Docker.
# When using docker-compose, the dashboard container gets this automatically.
# API_BASE_URL=http://localhost:8000
