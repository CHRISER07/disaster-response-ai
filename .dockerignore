## Disaster Response AI — Docker ignore
# Don't copy these into the container image

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# Virtual environment
venv/
.venv/
env/

# Database (mounted as volume at runtime)
chroma_db/

# Logs and output (mounted as volume)
logs/
data/alerts.jsonl
evaluation/results_*.csv

# Development files
.env
*.tex
archive/
tests/
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
